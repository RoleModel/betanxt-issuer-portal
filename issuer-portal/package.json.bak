{
  "name": "issuer-portal",
  "version": "1.0.0",
  "description": "Frontend application for proxy voting and shareholder meeting management",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev:inspect": "NODE_OPTIONS='--inspect' next dev",
    "start": "node .next/standalone/server.js",
    "lint": "eslint --fix .",
    "test": "npx playwright test",
    "type-check": "tsc --noEmit",
    "generate:types": "openapi-typescript ../mock-api-server/openapi-schema/openapi.yaml -o domain-models/generated-schema.ts",
    "generate:all-types": "npm run generate:types && cd ../mock-api-server && npm run generate:db-types",
    "format": "prettier --write .",
    "clean": "rm -rf .next node_modules/.cache"
  },
  "dependencies": {
    "@docuseal/signature-maker-react": "^1.0.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/lab": "^7.0.0-beta.17",
    "@mui/material": "^7.3.2",
    "@mui/material-nextjs": "^7.3.2",
    "@mui/utils": "^7.3.2",
    "@mui/x-charts": "^8.12.0",
    "@mui/x-date-pickers": "^8.11.3",
    "@next/bundle-analyzer": "^15.5.4",
    "@react-pdf/renderer": "^4.3.1",
    "@rolemodel/betanxt-design-system": "^1.0.0",
    "@supabase/supabase-js": "^2.58.0",
    "@vercel/speed-insights": "^1.2.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.22",
    "motion": "^12.23.12",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "number-abbreviate": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.3.93",
    "react": "^19.1.1",
    "react-audio-player": "^0.17.0",
    "react-doc-viewer": "^0.1.14",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-pdf": "^10.1.0",
    "react-player": "^3.3.3",
    "swr": "^2.3.6",
    "uuid": "^13.0.0",
    "motion-plus": "https://api.motion.dev/registry?package=motion-plus&version=1.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.36.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20.4.2",
    "@types/number-abbreviate": "^2.0.0",
    "@types/react": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.45.0",
    "eslint-config-next": "^14.0.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "openapi-fetch": "^0.8.2",
    "openapi-typescript": "^6.7.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}