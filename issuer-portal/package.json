{
  "name": "issuer-portal",
  "version": "1.0.0",
  "description": "Frontend application for proxy voting and shareholder meeting management",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint --fix",
    "test:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "generate:types": "openapi-typescript ../mock-api-server/openapi-schema/openapi.yaml -o domain-models/generated-schema.ts",
    "generate:all-types": "npm run generate:types && cd ../mock-api-server && npm run generate:db-types",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@docuseal/react": "^1.0.68",
    "@docuseal/signature-maker-react": "^1.0.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^3.1.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.2",
    "@mui/material-nextjs": "^7.3.2",
    "@mui/x-date-pickers": "^8.11.3",
    "@rolemodel/betanxt-design-system": "^0.0.55",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.4.0",
    "date-fns": "^4.1.0",
    "motion": "^12.23.12",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.45.2",
    "react-pdf": "^10.1.0",
    "svg2pdf.js": "^2.6.0",
    "swr": "^2.3.6",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.36.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.4.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "dotenv": "^16.6.1",
    "eslint": "^8.45.0",
    "eslint-config-next": "^14.0.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "motion-plus": "^1.5.1",
    "openapi-fetch": "^0.8.2",
    "openapi-typescript": "^6.7.3",
    "save": "^2.9.0",
    "typescript": "^5.9.2"
