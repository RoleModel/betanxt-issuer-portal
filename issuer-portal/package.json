{
  "name": "issuer-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend application for proxy voting and shareholder meeting management",
  "type": "module",
  "scripts": {
    "vercel-install": "echo 'Installing dependencies...' && pnpm install",
    "postinstall": "node scripts/generate-dev-source-manifest.mjs",
    "generate:dev-source": "node scripts/generate-dev-source-manifest.mjs",
    "build": "node scripts/generate-dev-source-manifest.mjs && next build",
    "dev": "node scripts/generate-dev-source-manifest.mjs && next dev",
    "dev:inspect": "node scripts/generate-dev-source-manifest.mjs && NODE_OPTIONS='--inspect' next dev",
    "start": "next start",
    "lint": "next lint",
    "test": "npx playwright test",
    "type-check": "pnpm --workspace-root exec tsc --noEmit -p issuer-portal/tsconfig.json",
    "generate:types": "openapi-typescript ../mock-api-server/openapi-schema/openapi.yaml -o domain-models/generated-schema.ts",
    "generate:api-types": "openapi-typescript ../mock-api-server/openapi-schema/openapi.yaml -o types/api.ts",
    "generate:all-types": "pnpm run generate:types && pnpm run generate:api-types && cd ../mock-api-server && pnpm run generate:db-types",
    "generate:mock-mailings": "tsx scripts/generate-mock-mailing-pdfs.tsx",
    "fetch:dark-logos": "tsx scripts/fetch-dark-logos.ts",
    "clean": "rm -rf .next node_modules/.cache",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.90",
    "@ai-sdk/react": "^3.0.241",
    "@docuseal/signature-maker-react": "^1.0.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@flags-sdk/vercel": "^1.4.6",
    "@mui/icons-material": "^7.3.11",
    "@mui/lab": "^7.0.0",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/utils": "^7.3.11",
    "@mui/x-charts": "^8.29.2",
    "@mui/x-charts-pro": "^8.29.2",
    "@mui/x-data-grid": "^8.29.2",
    "@mui/x-data-grid-pro": "^9.10.1",
    "@mui/x-date-pickers": "^8.29.2",
    "@mui/x-license": "^9.10.1",
    "@mui/x-scheduler": "9.0.0-beta.7",
    "@mui/x-scheduler-premium": "9.0.0-beta.7",
    "@mui/x-tree-view": "^9.10.1",
    "@next/bundle-analyzer": "^16.2.12",
    "@react-pdf/renderer": "^4.5.1",
    "@rolemodel/betanxt-design-system": "^1.1.2",
    "@rolemodel/client-theming": "^0.1.3",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/related-projects": "^1.1.0",
    "@vercel/speed-insights": "^1.3.1",
    "@visx/pattern": "^4.0.0",
    "ai": "^6.0.239",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "flags": "^4.2.4",
    "framer-motion": "^12.43.0",
    "mammoth": "^1.12.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "number-abbreviate": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.8",
    "react-audio-player": "^0.17.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.4.1",
    "react-pdf": "^10.4.1",
    "react-player": "^3.4.0",
    "swr": "^2.4.2",
    "turbo-ignore": "^2.10.8",
    "uuid": "^13.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.13.3",
    "@types/number-abbreviate": "^2.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "agentation": "^3.0.2",
    "axe-core": "~4.11.4",
    "baseline-browser-mapping": "^2.11.10",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "openapi-fetch": "^0.8.2",
    "openapi-typescript": "^6.7.6",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
