# Copy this file to .env.local.development and fill in your values

# NextAuth Configuration
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Auth Bypass (for development only)
NEXT_PUBLIC_BYPASS_AUTH="false"
NEXT_PUBLIC_BYPASS_USER_ID="dev-user-123"
NEXT_PUBLIC_BYPASS_USER_ROLE="ADMIN"

# API Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# Document Upload Settings
# Set to 'true' to require review for proxy materials (proxy cards, proxy statements, notices)
# Set to 'false' to mark them as uploaded immediately
NEXT_PUBLIC_REQUIRE_PROXY_REVIEW="true"

# Supabase (for frontend if needed)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
