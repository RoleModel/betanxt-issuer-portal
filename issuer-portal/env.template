# Copy this file to .env.local.development and fill in your values

# NextAuth Configuration
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Auth Bypass (for development only)
NEXT_PUBLIC_BYPASS_AUTH="false"
NEXT_PUBLIC_BYPASS_USER_ID="dev-user-123"
NEXT_PUBLIC_BYPASS_USER_ROLE="ADMIN"

# API Configuration (must include /api — matches openapi-fetch baseUrl)
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001/api"

# Document Upload Settings
# Set to 'true' to require review for uploaded documents
# Set to 'false' to mark them as uploaded immediately
NEXT_PUBLIC_REQUIRE_DOCUMENT_REVIEW="true"

# Developer Overlay (hover-to-inspect tool)
# Always on under `next dev`. Set to 'true' to also enable it on a deployment
# (e.g. Vercel Preview) so remote developers without the codebase can use it.
# Leave unset/'false' in Production.
NEXT_PUBLIC_ENABLE_DEV_OVERLAY="false"

# Supabase (for frontend if needed)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# AI Gateway
AI_GATEWAY_API_KEY="your-ai-gateway-api-key"
AI_GATEWAY_MODEL="openai/gpt-4.1-mini"
# Optional override if your gateway uses a different OpenAI-compatible base URL
# AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"
