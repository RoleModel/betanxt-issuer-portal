# NextAuth Configuration
AUTH_TRUST_HOST=true
# NEXTAUTH_URL is intentionally NOT set here — NextAuth v5 with trustHost: true
# auto-detects the correct URL from request headers. Setting it explicitly breaks
# Vercel deployments by hardcoding localhost as the cookie domain and redirect URL.
# For local development, NextAuth defaults to http://localhost:3000 automatically.
NEXTAUTH_SECRET=65393f082e1c49e654b9bf339022955c3f02b2a62db97098c241198e53d824bd

# Auth Bypass (for development only)
# Set NEXT_PUBLIC_BYPASS_AUTH=false to use the login page with credentials
NEXT_PUBLIC_BYPASS_AUTH=false
NEXT_PUBLIC_BYPASS_USER_ID=dev-user-123
# Supported roles: ADMIN, ISSUER, PARENT_CLIENT, SOLICITOR, CSM
NEXT_PUBLIC_BYPASS_USER_ROLE=CSM

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Document Upload Settings
# Set to 'true' to require review for uploaded documents
# Set to 'false' to mark them as uploaded immediately
NEXT_PUBLIC_REQUIRE_DOCUMENT_REVIEW=true
BRANDFETCH_API_KEY=59HW34biAjj81xy1GOjVk6AfmwUYUr4+pTzwV8Xqqjg=