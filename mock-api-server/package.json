{
  "name": "mock-api-server",
  "version": "1.0.0",
  "description": "Mock API server for proxy voting and shareholder meeting management",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch app/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "generate:api-types": "openapi-typescript ../contracts/openapi.yaml -o ./types/api.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "openapi-fetch": "^0.14.0",
    "winston": "^3.10.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.36.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.2",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "eslint": "^8.45.0",
    "openapi-typescript": "^7.9.1",
    "prisma": "^5.0.0",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@9.0.0"
}
