{
  "name": "mock-api-server",
  "version": "1.0.0",
  "description": "Mock API server for proxy voting and shareholder meeting management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:integration": "playwright test --project=integration",
    "test:unit": "playwright test --project=unit",
    "test:ts": "tsc --noEmit",
    "test:e2e": "playwright test --project=e2e",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "generate:seeds": "npx tsx ../supabase/seed.ts && npx tsx ../supabase/seed.ts > ../supabase/seed.sql",
    "generate:db-types": "supabase gen types typescript --local --schema public > utils/supabase/database.types.ts",
    "generate:postgres-schema": "openapi-generator-cli generate -i ./openapi-schema/openapi.yaml -g postgresql-schema -o ../supabase/migrations --additional-properties=identifierNamingConvention=snake_case,defaultDatabaseName=public,schemaName=public && npx tsx cli/extract-core-schema.ts",
    "seed:validate": "npx tsx cli/validate-seed.ts",
    "seed:reset": "supabase db reset && npm run generate:seeds",
    "full-reset": "npm run generate:postgres-schema && npm run generate:seeds && supabase db reset && npm run generate:db-types && npm run generate:api-types",
    "generate:api-types": "openapi-typescript ./openapi-schema/openapi.yaml -o ./types/api.ts",
    "generate:api-routes": "npx tsx cli/generate-routes.ts",
    "generate:all": "npm run generate:api-types && npm run generate:api-routes",
    "setup:storage": "tsx scripts/ensure-documents-bucket.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.3",
    "luxon": "^3.6.0",
    "next": "^15.5.4",
    "openapi-fetch": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "znv": "^0.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@openapitools/openapi-generator-cli": "^2.23.3",
    "@playwright/test": "^1.36.2",
    "@snaplet/copycat": "^6.0.0",
    "@snaplet/seed": "^0.98.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.2",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "csv-parser": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "globals": "^15.15.0",
    "js-yaml": "^4.1.0",
    "openapi-typescript": "^7.9.1",
    "postgres": "^3.4.5",
    "prisma": "^5.0.0",
    "tsx": "^3.12.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
