{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Supabase seed & utility scripts (run via tsx)",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["functions"]
}
