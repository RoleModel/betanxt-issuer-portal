meta {
  name: Get proposal by ID
  type: http
  seq: 3
  tags: [
    Proposals
  ]
}

get {
  url: {{baseUrl}}/proposals/:id
  body: none
  auth: inherit
}

params:path {
  id: 
}

example {
  name: 200 Response
  description: Proposal retrieved successfully
  
  request: {
    url: {{baseUrl}}/proposals/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
