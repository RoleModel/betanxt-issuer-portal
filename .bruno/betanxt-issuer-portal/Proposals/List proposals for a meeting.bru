meta {
  name: List proposals for a meeting
  type: http
  seq: 1
  tags: [
    Proposals
  ]
}

get {
  url: {{baseUrl}}/meetings/:meetingId/proposals
  body: none
  auth: inherit
}

params:query {
  ~proposalType: 
}

params:path {
  meetingId: 
}

example {
  name: 200 Response
  description: Proposals retrieved successfully
  
  request: {
    url: {{baseUrl}}/meetings/:meetingId/proposals
    method: GET
    mode: none
    params:query: {
      ~proposalType: 
    }
  
    params:path: {
      meetingId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": "be601464-c593-5d74-b6f6-c14152132103",
            "meetingId": "01234567-89ab-cdef-0123-456789abcdef",
