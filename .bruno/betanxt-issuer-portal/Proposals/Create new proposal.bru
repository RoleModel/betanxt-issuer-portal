meta {
  name: Create new proposal
  type: http
  seq: 2
  tags: [
    Proposals
  ]
}

post {
  url: {{baseUrl}}/meetings/:meetingId/proposals
  body: json
  auth: inherit
}

params:path {
  meetingId: 
}

body:json {
  {
    "proposalNumber": 0,
    "proposalTitle": "",
    "proposalType": "",
    "proposalSubtype": "",
    "directorName": "",
    "directorTermYears": 0,
    "directorClass": "",
    "termExpirationYear": 0,
    "frequencyOptions": {},
    "recommendation": ""
  }
}

example {
  name: 201 Response
  description: Proposal created successfully
  
  request: {
    url: {{baseUrl}}/meetings/:meetingId/proposals
    method: POST
    mode: json
    params:path: {
      meetingId: 
    }
  
    body:json: {
      {
        "proposalNumber": 0,
        "proposalTitle": "",
        "proposalType": "",
        "proposalSubtype": "",
        "directorName": "",
        "directorTermYears": 0,
        "directorClass": "",
        "termExpirationYear": 0,
        "frequencyOptions": {},
        "recommendation": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
