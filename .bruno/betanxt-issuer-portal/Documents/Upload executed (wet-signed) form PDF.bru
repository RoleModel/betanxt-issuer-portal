meta {
  name: Upload executed (wet-signed) form PDF
  type: http
  seq: 8
  tags: [
    Documents
  ]
}

post {
  url: {{baseUrl}}/documents/forms/:formType/upload-executed
  body: multipartForm
  auth: inherit
}

params:path {
  formType: FORM_OF_PROXY
  formType: VIF
  formType: CONTROLLED_ACCOUNT_REPORT
}

body:multipart-form {
  meetingId: 
  @description('Executed (signed) form PDF')
  file: @file()
  @description('If provided, links the upload to a previously generated draft form')
  originalGeneratedId: 
}

