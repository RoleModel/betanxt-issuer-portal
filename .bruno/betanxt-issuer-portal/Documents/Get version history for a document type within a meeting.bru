meta {
  name: Get version history for a document type within a meeting
  type: http
  seq: 13
  tags: [
    Documents
  ]
}

get {
  url: {{baseUrl}}/documents/types/:documentType/history
  body: none
  auth: inherit
}

params:query {
  meetingId: 
}

params:path {
  documentType: 
}

