meta {
  name: Get current user profile
  type: http
  seq: 3
  tags: [
    Authentication
  ]
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: User profile retrieved
  
  request: {
    url: {{baseUrl}}/auth/me
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "b1f5062a-09b6-5dc1-b18c-3800c5930eab",
