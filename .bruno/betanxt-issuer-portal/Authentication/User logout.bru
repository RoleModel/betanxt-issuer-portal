meta {
  name: User logout
  type: http
  seq: 2
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Logout successful
  
  request: {
    url: {{baseUrl}}/auth/logout
    method: POST
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Logged out successfully"
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized
  
  request: {
    url: {{baseUrl}}/auth/logout
    method: POST
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "",
          "code": "",
          "details": {}
        }
      '''
    }
  }
}
