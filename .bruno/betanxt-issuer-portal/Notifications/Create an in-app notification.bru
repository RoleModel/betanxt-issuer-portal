meta {
  name: Create an in-app notification
  type: http
  seq: 2
  tags: [
    Notifications
  ]
}

post {
  url: {{baseUrl}}/notifications
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "",
    "meetingId": "",
    "title": "Daily Tabulation Report Available",
    "message": "",
    "type": "info",
    "priority": "low",
    "actionUrl": ""
  }
}

example {
  name: 201 Response
  description: Notification created
  
  request: {
    url: {{baseUrl}}/notifications
    method: POST
    mode: json
    body:json: {
      {
        "userId": "",
        "meetingId": "",
        "title": "Daily Tabulation Report Available",
        "message": "",
        "type": "info",
        "priority": "low",
        "actionUrl": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "389e5e4b-10e5-5eed-8047-3da0e36f051b",
