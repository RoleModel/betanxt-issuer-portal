meta {
  name: Get digital shareholder meeting attendees
  type: http
  seq: 9
  tags: [
    Meetings
  ]
}

get {
  url: {{baseUrl}}/meetings/:meetingId/digital-shareholder-meeting
  body: none
  auth: inherit
}

params:path {
  @description('Meeting ID')
  meetingId: 
}

