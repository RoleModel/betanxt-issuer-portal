meta {
  name: Bulk create digital shareholder meeting attendees
  type: http
  seq: 10
  tags: [
    Meetings
  ]
}

post {
  url: {{baseUrl}}/meetings/:meetingId/digital-shareholder-meeting
  body: json
  auth: inherit
}

params:path {
  meetingId: 
}

body:json {
  [
    {
      "registrantType": "Shareholder",
      "firstName": "",
      "lastName": "",
      "emailAddress": "",
      "registrationQuestions": "",
      "minutesAttendedMeeting": 0
    }
  ]
}

example {
  name: 201 Response
  description: Attendees created successfully
  
  request: {
    url: {{baseUrl}}/meetings/:meetingId/digital-shareholder-meeting
    method: POST
    mode: json
    params:path: {
      meetingId: 
    }
  
    body:json: {
      [
        {
          "registrantType": "Shareholder",
          "firstName": "",
          "lastName": "",
          "emailAddress": "",
          "registrationQuestions": "",
          "minutesAttendedMeeting": 0
        }
      ]
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": "",
            "meetingId": "",
            "registrantType": "Shareholder",
            "firstName": "",
            "lastName": "",
            "emailAddress": "",
            "registrationQuestions": "",
            "minutesAttendedMeeting": 0,
            "createdAt": "",
            "updatedAt": ""
          }
        ]
      '''
    }
  }
}

