example {
  name: 401 Response
  description: Unauthorized
  
  request: {
    url: {{baseUrl}}/meetings
    method: GET
    mode: none
    params:query: {
      page: 1
      limit: 20
      ~status: ACTIVE
      ~status: COMPLETE
      ~status: ADJOURNED
      ~clientId: 
      ~meetingYear: 
      ~cusip: 
      ~ticker: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "",
          "code": "",
          "details": {}
        }
      '''
    }
  }
}
