meta {
  name: List meetings
  type: http
  seq: 1
  tags: [
    Meetings
  ]
}

get {
  url: {{baseUrl}}/meetings
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
  ~status: ACTIVE
  ~status: COMPLETE
  ~status: ADJOURNED
  @description('Filter by client ID')
  ~clientId: 
  ~meetingYear: 
  ~cusip: 
  ~ticker: 
}

