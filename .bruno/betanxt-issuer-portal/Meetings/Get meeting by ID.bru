meta {
  name: Get meeting by ID
  type: http
  seq: 3
  tags: [
    Meetings
  ]
}

get {
  url: {{baseUrl}}/meetings/:meetingId
  body: none
  auth: inherit
}

params:path {
  meetingId: 
}

