meta {
  name: Update account
  type: http
  seq: 4
  tags: [
    Accounts
  ]
}

put {
  url: {{baseUrl}}/accounts/:accountId
  body: json
  auth: inherit
}

params:path {
  accountId: 
}

body:json {
  {
    "name": "",
    "primaryContact": "",
    "clientId": ""
  }
}

example {
  name: 200 Response
  description: Account updated successfully
  
  request: {
    url: {{baseUrl}}/accounts/:accountId
    method: PUT
    mode: json
    params:path: {
      accountId: 
    }
  
    body:json: {
      {
        "name": "",
        "primaryContact": "",
        "clientId": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "name": "",
          "primaryContact": "",
          "clientId": "",
          "createdAt": "",
          "client": {
            "id": "291cdbe5-192b-50ec-b3ae-3197c9c5103c",
            "ticker": "WEN",
