meta {
  name: List accounts
  type: http
  seq: 1
  tags: [
    Accounts
  ]
}

get {
  url: {{baseUrl}}/accounts
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
}

example {
  name: 200 Response
  description: Accounts retrieved successfully
  
  request: {
    url: {{baseUrl}}/accounts
    method: GET
    mode: none
    params:query: {
      page: 1
      limit: 20
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
