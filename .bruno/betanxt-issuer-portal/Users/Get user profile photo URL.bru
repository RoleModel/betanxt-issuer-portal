meta {
  name: Get user profile photo URL
  type: http
  seq: 9
  tags: [
    Users
    Profile
  ]
}

get {
  url: {{baseUrl}}/users/:id/avatar/url
  body: none
  auth: inherit
}

params:path {
  @description('The ID of the user')
  id: 
}

example {
  name: 200 Response
  description: Avatar URL retrieved successfully
  
  request: {
    url: {{baseUrl}}/users/:id/avatar/url
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "avatarUrl": ""
        }
      '''
    }
  }
}

