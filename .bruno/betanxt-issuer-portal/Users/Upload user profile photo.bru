meta {
  name: Upload user profile photo
  type: http
  seq: 7
  tags: [
    Users
    Profile
  ]
}

post {
  url: {{baseUrl}}/users/:id/avatar
  body: multipartForm
  auth: inherit
}

params:path {
  @description('The ID of the user')
  id: 
}

body:multipart-form {
  @description('The profile photo file (JPEG, PNG, WebP)')
  avatar: @file()
  @description('Scale factor for cropping (0.5x to 2x zoom)')
  scale: 1
}

example {
  name: 201 Response
  description: Avatar uploaded successfully
  
  request: {
    url: {{baseUrl}}/users/:id/avatar
    method: POST
    mode: multipartForm
    params:path: {
      id: 
    }
  
    body:multipart-form: {
      avatar: @file()
      scale: 1
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "avatarUrl": "",
          "message": "Avatar uploaded successfully"
        }
      '''
    }
  }
}

