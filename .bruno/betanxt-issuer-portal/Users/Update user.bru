meta {
  name: Update user
  type: http
  seq: 4
  tags: [
    Users
  ]
}

put {
  url: {{baseUrl}}/users/:id
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "firstName": "",
    "lastName": "",
    "email": "",
    "type": "ADMIN",
    "accountId": "",
    "avatar_url": "https://example.supabase.co/storage/v1/object/public/user-avatars/123e4567-e89b-12d3-a456-426614174000.jpg"
  }
}

example {
