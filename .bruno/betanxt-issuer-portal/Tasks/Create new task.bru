meta {
  name: Create new task
  type: http
  seq: 2
  tags: [
    Tasks
  ]
}

post {
  url: {{baseUrl}}/meetings/:meetingId/tasks
  body: json
  auth: inherit
}

params:path {
  meetingId: 
}

body:json {
  {
    "taskId": "",
    "phaseId": "",
    "phaseNumber": 0,
    "title": "",
    "description": "",
    "type": "",
    "dueDate": "",
    "owner": "",
    "documentId": "",
    "links": {}
  }
}

example {
  name: 201 Response
  description: Task created successfully
  
  request: {
    url: {{baseUrl}}/meetings/:meetingId/tasks
    method: POST
    mode: json
    params:path: {
      meetingId: 
    }
  
    body:json: {
      {
        "taskId": "",
        "phaseId": "",
        "phaseNumber": 0,
        "title": "",
        "description": "",
        "type": "",
        "dueDate": "",
        "owner": "",
        "documentId": "",
        "links": {}
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "81c351e9-36cd-5528-b5a4-f48b2fe05bd6",
          "taskId": "wen-annual-meeting-2026-P1-1",
