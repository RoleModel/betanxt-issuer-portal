meta {
  name: Get task by ID
  type: http
  seq: 4
  tags: [
    Tasks
  ]
}

get {
  url: {{baseUrl}}/tasks/:id
  body: none
  auth: inherit
}

params:path {
  id: 
}

example {
  name: 200 Response
  description: Task retrieved successfully
  
  request: {
    url: {{baseUrl}}/tasks/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
