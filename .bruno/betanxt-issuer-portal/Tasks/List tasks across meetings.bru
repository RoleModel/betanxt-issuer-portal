meta {
  name: List tasks across meetings
  type: http
  seq: 3
  tags: [
    Tasks
  ]
}

get {
  url: {{baseUrl}}/tasks
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 100
  @description('''
    Exclude tasks in a completion status. The completion set is the same one phase advancement uses, so "open" here means the task is still holding its meeting up.
    
  ''')
  openOnly: false
  @description('Comma-separated list of meeting ids to restrict the query to.')
  ~meetingId: 
  ~status: INCOMPLETE
  ~status: COMPLETE
  ~status: CANCELLED
  ~status: NEEDS_AUTHORIZATION
  ~status: AUTHORIZED
  ~status: PENDING_AUTHORIZATION
  ~status: WAITING_FOR_FORM_RETURN
  ~status: AUTHORIZATION_NEEDED
  ~status: SUBMITTED_AWAITING_RECORD_DATE
  ~status: REQUEST_FORM_TO_FOLLOW
  ~status: AWAITING_REVIEW
  @description('Only return tasks with a due date strictly before this date.')
  ~dueBefore: 
}

docs {
  Cross-meeting task query. Exists so callers that need task state for many meetings at once (for example, deriving which events are behind schedule on the events index) can issue a single request instead of one request per meeting. Filters are applied server-side so the response stays small.
  
}

example {
  name: 200 Response
  description: Tasks retrieved successfully
  
  request: {
    url: {{baseUrl}}/tasks
    method: GET
    mode: none
    params:query: {
      page: 1
      limit: 100
      ~meetingId: 
      ~status: INCOMPLETE
      ~status: COMPLETE
      ~status: CANCELLED
      ~status: NEEDS_AUTHORIZATION
      ~status: AUTHORIZED
      ~status: PENDING_AUTHORIZATION
      ~status: WAITING_FOR_FORM_RETURN
      ~status: AUTHORIZATION_NEEDED
      ~status: SUBMITTED_AWAITING_RECORD_DATE
      ~status: REQUEST_FORM_TO_FOLLOW
      ~status: AWAITING_REVIEW
      ~dueBefore: 
      openOnly: false
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "tasks": [
            {
              "id": "81c351e9-36cd-5528-b5a4-f48b2fe05bd6",
              "taskId": "wen-annual-meeting-2026-P1-1",
              "phaseId": "11111111-2222-3333-4444-555555555555",
              "meetingId": "wen-annual-meeting-2026",
              "phaseNumber": 1,
              "title": "DTCC (SPR) Authorization Status",
              "description": "Check and confirm authorization status with DTCC for shareholder proxy record access.",
              "type": "Authorization",
              "status": "INCOMPLETE",
              "dueDate": "2025-12-22",
              "owner": "The Wendy's Company",
              "documentId": "33333333-4444-5555-6666-777777777777",
              "links": {},
              "createdAt": "",
              "updatedAt": ""
            }
          ],
          "pagination": {
            "page": 0,
            "limit": 0,
            "total": 0,
            "pages": 0
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized
  
  request: {
    url: {{baseUrl}}/tasks
    method: GET
    mode: none
    params:query: {
      page: 1
      limit: 100
      ~meetingId: 
      ~status: INCOMPLETE
      ~status: COMPLETE
      ~status: CANCELLED
      ~status: NEEDS_AUTHORIZATION
      ~status: AUTHORIZED
      ~status: PENDING_AUTHORIZATION
      ~status: WAITING_FOR_FORM_RETURN
      ~status: AUTHORIZATION_NEEDED
      ~status: SUBMITTED_AWAITING_RECORD_DATE
      ~status: REQUEST_FORM_TO_FOLLOW
      ~status: AWAITING_REVIEW
      ~dueBefore: 
      openOnly: false
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "",
          "code": "",
          "details": {}
        }
      '''
    }
  }
}
