meta {
  name: Get pre-calculated tabulation report for a meeting
  type: http
  seq: 1
  tags: [
    Reports
  ]
}

get {
  url: {{baseUrl}}/meetings/:meetingId/tabulation-report
  body: none
  auth: inherit
}

params:path {
  meetingId: 
}

example {
  name: 200 Response
  description: Tabulation report retrieved successfully
  
  request: {
    url: {{baseUrl}}/meetings/:meetingId/tabulation-report
    method: GET
    mode: none
    params:path: {
      meetingId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "meetingId": "",
          "setKeys": [],
          "brokerVoting": {},
          "shareRangePerformance": [
            {
              "rangeLabel": "",
              "positionCount": 0,
              "totalShares": 0,
              "percentVoted": 0
            }
          ],
          "nonDtcVoteStatus": {
            "unvotedShareholders": 0,
            "unvotedShares": 0,
            "printShareholders": 0,
            "printShares": 0,
            "ivrShareholders": 0,
            "ivrShares": 0,
            "webShareholders": 0,
            "webShares": 0,
            "votedSubtotalShareholders": 0,
            "votedSubtotalShares": 0,
            "grandTotalShareholders": 0,
            "grandTotalShares": 0
          },
          "dtcVoteStatus": {
            "unvotedShareholders": 0,
            "unvotedShares": 0,
            "votedShareholders": 0,
            "votedShares": 0,
            "grandTotalShareholders": 0,
            "grandTotalShares": 0
          },
          "voteDistribution": {
            "dtcVotedShares": 0,
            "dtcUnvotedShares": 0,
            "nonDtcVotedShares": 0,
            "nonDtcUnvotedShares": 0
          },
          "positionsVoted": {
            "voted": 0,
            "unvoted": 0,
            "totalShares": 0,
            "votedShares": 0
          },
          "lastCalculatedAt": "",
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized
  
  request: {
    url: {{baseUrl}}/meetings/:meetingId/tabulation-report
    method: GET
    mode: none
    params:path: {
      meetingId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "",
          "code": "",
          "details": {}
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Not found
  
  request: {
    url: {{baseUrl}}/meetings/:meetingId/tabulation-report
    method: GET
    mode: none
    params:path: {
      meetingId: 
    }
  }
  
  response: {
    headers: {
