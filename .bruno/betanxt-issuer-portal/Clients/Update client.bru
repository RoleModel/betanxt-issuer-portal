meta {
  name: Update client
  type: http
  seq: 4
  tags: [
    Clients
  ]
}

put {
  url: {{baseUrl}}/clients/:ticker
  body: json
  auth: inherit
}

params:path {
  @description('The client ticker symbol')
  ticker: 
}

body:json {
  {
    "companyName": "",
    "shortName": "",
    "industry": "",
    "description": "",
    "website": "",
    "primaryContact": "",
    "primaryContactEmail": "",
    "isActive": false,
    "brandingId": 966152,
    "logoUrl": "",
    "primaryColor": "",
    "secondaryColor": "",
    "enabledFeatures": [
      "documents"
    ]
  }
}

example {
  name: 200 Response
  description: Client updated successfully
  
  request: {
    url: {{baseUrl}}/clients/:ticker
    method: PUT
    mode: json
    params:path: {
      ticker: 
    }
  
    body:json: {
      {
        "companyName": "",
        "shortName": "",
        "industry": "",
        "description": "",
        "website": "",
        "primaryContact": "",
        "primaryContactEmail": "",
        "isActive": false,
        "brandingId": 966152,
        "logoUrl": "",
        "primaryColor": "",
        "secondaryColor": "",
        "enabledFeatures": [
          "documents"
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "291cdbe5-192b-50ec-b3ae-3197c9c5103c",
          "ticker": "WEN",
          "companyName": "The Wendy's Company",
          "shortName": "Wendy's",
          "industry": "Restaurants",
          "description": "Leading fast food hamburger chain",
          "website": "https://www.wendys.com",
          "primaryContact": "Mike Chen",
          "primaryContactEmail": "mike.chen@wendys.com",
          "isActive": true,
          "brandingId": 966152,
          "logoUrl": "",
          "primaryColor": "#1A3C5E",
          "secondaryColor": "#E8A020",
          "createdBy": "",
          "enabledFeatures": [
            "documents",
            "mailing",
            "tabulation",
            "reports",
            "fileTransfer",
            "agenda"
          ],
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

