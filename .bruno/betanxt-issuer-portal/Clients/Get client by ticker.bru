meta {
  name: Get client by ticker
  type: http
  seq: 3
  tags: [
    Clients
  ]
}

get {
  url: {{baseUrl}}/clients/:ticker
  body: none
  auth: inherit
}

params:path {
  @description('The client ticker symbol')
  ticker: 
}

example {
  name: 200 Response
  description: Client retrieved successfully
  
  request: {
    url: {{baseUrl}}/clients/:ticker
    method: GET
    mode: none
    params:path: {
      ticker: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "291cdbe5-192b-50ec-b3ae-3197c9c5103c",
          "ticker": "WEN",
          "companyName": "The Wendy's Company",
          "shortName": "Wendy's",
          "industry": "Restaurants",
          "description": "Leading fast food hamburger chain",
          "website": "https://www.wendys.com",
          "primaryContact": "Mike Chen",
          "primaryContactEmail": "mike.chen@wendys.com",
          "isActive": true,
          "brandingId": 966152,
          "logoUrl": "",
          "primaryColor": "#1A3C5E",
          "secondaryColor": "#E8A020",
          "createdBy": "",
          "enabledFeatures": [
            "documents",
            "mailing",
            "tabulation",
            "reports",
            "fileTransfer",
            "agenda"
          ],
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

