meta {
  name: Add comment to a document
  type: http
  seq: 2
  tags: [
    Comments
  ]
}

post {
  url: {{baseUrl}}/documents/:id/comments
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "comment": ""
  }
}

