meta {
  name: Get phase by ID
  type: http
  seq: 3
  tags: [
    Phases
  ]
}

get {
  url: {{baseUrl}}/phases/:id
  body: none
  auth: inherit
}

params:path {
  id: 
}

example {
  name: 200 Response
  description: Phase retrieved successfully
  
  request: {
    url: {{baseUrl}}/phases/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "11111111-2222-3333-4444-555555555555",
          "meetingId": "01234567-89ab-cdef-0123-456789abcdef",
          "name": "Notice & Access",
