meta {
  name: Update phase
  type: http
  seq: 4
  tags: [
    Phases
  ]
}

put {
  url: {{baseUrl}}/phases/:id
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "name": "",
    "orderIndex": 0,
    "status": "IN_PROGRESS",
    "keyDates": {
      "startDate": "",
      "endDate": "",
      "dueDate": "",
      "completionDate": ""
    }
  }
}

example {
  name: 200 Response
  description: Phase updated successfully
  
  request: {
    url: {{baseUrl}}/phases/:id
    method: PUT
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "name": "",
        "orderIndex": 0,
        "status": "IN_PROGRESS",
        "keyDates": {
          "startDate": "",
          "endDate": "",
          "dueDate": "",
          "completionDate": ""
        }
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
