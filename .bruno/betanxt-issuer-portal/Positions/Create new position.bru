meta {
  name: Create new position
  type: http
  seq: 2
  tags: [
    Positions
  ]
}

post {
  url: {{baseUrl}}/positions
  body: json
  auth: inherit
}

body:json {
  {
    "meetingId": "",
    "cusip": "",
    "accountType": "",
    "setKey": "",
    "name": "",
    "accountNumber": "",
    "controlNumber": "",
    "voteStatus": "Voted",
    "shares": 0,
    "sharesVoted": 0,
    "source": "WEB",
    "dateVoted": ""
  }
}

example {
  name: 201 Response
  description: Position created successfully
  
  request: {
    url: {{baseUrl}}/positions
    method: POST
    mode: json
    body:json: {
      {
        "meetingId": "",
        "cusip": "",
        "accountType": "",
        "setKey": "",
        "name": "",
        "accountNumber": "",
        "controlNumber": "",
        "voteStatus": "Voted",
        "shares": 0,
        "sharesVoted": 0,
        "source": "WEB",
        "dateVoted": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "90953927-6e41-5c55-be8b-a690299746ad",
