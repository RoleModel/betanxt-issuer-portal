{
  "name": "issuer-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Proxy voting and shareholder meeting management system",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "pnpm --filter issuer-portal run build",
    "build:all": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "test": "turbo run test",
    "clean": "pnpm --filter issuer-portal run clean && pnpm --filter mock-api-server run clean",
    "clean:all": "rm -rf .next issuer-portal/.next mock-api-server/.next node_modules issuer-portal/node_modules mock-api-server/node_modules .turbo",
    "format": "prettier --write .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "doctor": "ultracite doctor",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@rolemodel/client-theming": "0.1.3",
    "@snaplet/copycat": "^6.0.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/luxon": "^3.7.3",
    "@vercel/analytics": "^1.6.1",
    "luxon": "^3.7.2",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "agentation": "^3.0.2",
    "baseline-browser-mapping": "^2.11.10",
    "eslint": "^10.8.0",
    "eslint-config-next": "^15.5.22",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-github": "6.0.0",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-doctor": "^0.7.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-storybook": "^10.5.5",
    "eslint-plugin-unicorn": "^70.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.5.5",
    "stylelint": "^17.14.1",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "turbo": "^2.10.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "ultracite": "7.9.4"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
