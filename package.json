{
  "name": "issuer-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Proxy voting and shareholder meeting management system",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter issuer-portal run build",
    "build:all": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "test": "turbo run test",
    "clean": "pnpm --filter issuer-portal run clean && pnpm --filter mock-api-server run clean",
    "clean:all": "rm -rf .next issuer-portal/.next mock-api-server/.next node_modules issuer-portal/node_modules mock-api-server/node_modules .turbo",
    "format": "prettier --write .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@snaplet/copycat": "^6.0.0",
    "@supabase/supabase-js": "^2.58.0",
    "@vercel/analytics": "^1.5.0",
    "luxon": "^3.7.2",
    "next": "^16.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^15.5.4",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "agentation": "^3.0.2",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "prettier": "^3.6.2",
    "turbo": "^2.10.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
