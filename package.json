{
  "name": "issuer-portal",
  "version": "1.0.0",
  "description": "Proxy voting and shareholder meeting management system",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "workspaces": [
    "mock-api-server",
    "issuer-portal"
  ],
  "scripts": {
    "build": "npm run build --workspace=issuer-portal",
    "build:all": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "test": "turbo run test",
    "clean": "npm run clean --workspace=issuer-portal && npm run clean --workspace=mock-api-server",
    "clean:all": "rm -rf .next issuer-portal/.next mock-api-server/.next node_modules issuer-portal/node_modules mock-api-server/node_modules .turbo",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:strict": "eslint -c eslint.strict.config.mjs ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^15.5.4",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.6.2",
    "turbo": "^2.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@snaplet/copycat": "^6.0.0",
    "@supabase/supabase-js": "^2.58.0",
    "@vercel/analytics": "^1.5.0",
    "luxon": "^3.7.2",
    "next": "16.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  }
}
