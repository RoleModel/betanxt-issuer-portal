#!/bin/sh

# Git clients do not necessarily start an interactive shell, so load the
# GitHub Packages token from the authenticated GitHub CLI session when needed.
if [ -z "$GITHUB_TOKEN" ]; then
  GH_EXECUTABLE="$(command -v gh 2>/dev/null || true)"
  if [ -z "$GH_EXECUTABLE" ] && [ -x /opt/homebrew/bin/gh ]; then
    GH_EXECUTABLE=/opt/homebrew/bin/gh
  fi

  if [ -n "$GH_EXECUTABLE" ]; then
    GITHUB_TOKEN="$($GH_EXECUTABLE auth token 2>/dev/null || true)"
    export GITHUB_TOKEN
  fi
  unset GH_EXECUTABLE
fi

# Keep commits gated by deterministic checks. The full cross-browser Playwright
# suite remains a CI check and is too broad and environment-dependent for a
# local pre-commit hook.

# Refresh the dev-overlay source snapshot before the checks run, so a component
# change is reflected in the (git-ignored) manifest the type-check reads. The
# deployed manifest is regenerated separately by the issuer-portal `prebuild`
# script, so this keeps local and CI/deploy in sync.
node issuer-portal/scripts/generate-dev-source-manifest.mjs

pnpm run lint
pnpm --filter issuer-portal run type-check
pnpm run check

# The mock-api-server unit suite used to run here too. It dominated the time
# every commit took, so it is now run on demand:
#
#   pnpm --filter mock-api-server run test:unit
#
# Nothing runs it automatically — no workflow in .github/workflows does — so
# run it before opening a PR that touches the API or its domain models.
