{
  "$schema": "https://v2-10-2.turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "GITHUB_TOKEN",
        "ANTHROPIC_API_KEY",
        "GH_TOKEN",
        "NPM_TOKEN",
        "GITHUB_PACKAGES_TOKEN",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_JWT_SECRET",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "AUTH_TRUST_HOST",
        "API_BASE_URL",
        "POSTGRES_URL",
        "POSTGRES_PRISMA_URL",
        "POSTGRES_URL_NON_POOLING",
        "POSTGRES_USER",
        "POSTGRES_HOST",
        "POSTGRES_PASSWORD",
        "NEXT_PUBLIC_MUI_X_LICENSE",
        "FLAGS_SECRET",
        "POSTGRES_DATABASE",
        "SEED_SQL_URL",
        "VERCEL_DEPLOY_HOOK_URL",
        "AI_GATEWAY_API_KEY",
        "ENABLE_EMAILS",
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "EMAIL_SMTP_HOST",
        "EMAIL_SMTP_PORT",
        "EMAIL_SMTP_SECURE",
        "EMAIL_SMTP_USER",
        "EMAIL_SMTP_PASS",
        "RESEND_API_KEY",
        "PORTAL_BASE_URL"
      ]
    },
    "build:test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "build"
      ]
    },
    "start:test": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "build:test"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:e2e": {},
    "test:unit": {
      "dependsOn": [
        "^build"
      ]
    },
    "docker:build": {
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {},
    "clean": {
      "cache": false
    }
  }
}
