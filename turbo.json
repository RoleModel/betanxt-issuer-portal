{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "GITHUB_TOKEN",
        "ANTHROPIC_API_KEY",
        "GH_TOKEN",
        "GITHUB_PACKAGES_TOKEN"
      ]
    },
    "build:test": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "start:test": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build:test"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {},
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "docker:build": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {},
    "clean": {
      "cache": false
    }
  }
}
